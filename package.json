{
  "name": "pocket-pulse",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "doctor": "expo-doctor",
    "audit:production": "npm audit --omit=dev --json | node scripts/check-production-audit.cjs"
  },
  "dependencies": {
    "@expo/ngrok": "4.1.3",
    "expo": "~54.0.37",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "~19.1.10",
    "eslint": "9.39.5",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.2",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "3.9.6",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "overrides": {
    "postcss": "8.5.26",
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
